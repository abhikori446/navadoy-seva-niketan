# =======================================================
# Navadoy Seva Niketan (NSN) - Environment Variables
# =======================================================

# Port on which the production server listens (defaults to 3000, Hostinger assigns dynamically)
PORT=3000

# Node Environment ('production' for live hosting on Hostinger, 'development' for local)
NODE_ENV=production

# GEMINI_API_KEY: Optional key for Gemini AI API integrations
GEMINI_API_KEY=""

# APP_URL: The public canonical URL of the deployed application (e.g., https://yourdomain.com)
APP_URL=""

